<?xml version="1.0" encoding="utf-8"?>
<!--
  Proyecto del plugin residente hidmouse.xex (Xbox 360, XDK VS2010).
  Basado en x360remap/hiddriver.vcxproj. Salida: DynamicLibrary (/dll) marcada
  como sysdll (xex.xml) -> plugin de DashLaunch.

  NOTA (build del usuario): este .vcxproj NO enlaza xkelib (no lo necesitamos:
  resolvemos las funciones del kernel por ordinal con GetProcAddress). Si tu
  entorno exige xkelib para construir un sysdll, copia la carpeta xkelib de
  x360remap y añade su include/lib. El postbuild usa xextool.exe (cópialo de
  x360remap\hiddriver o de tu XDK) para fijar privilegios del .xex.
-->
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|Xbox 360">
      <Configuration>Release</Configuration>
      <Platform>Xbox 360</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{7B0E5A11-2C3D-4E5F-9A10-11223344AA55}</ProjectGuid>
    <Keyword>Xbox360Proj</Keyword>
    <ProjectName>hidmouse</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <CharacterSet>MultiByte</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <PlatformToolset>2010-01</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <LinkIncremental>false</LinkIncremental>
    <PostBuildEventUseInBuild>false</PostBuildEventUseInBuild>
    <RemoteRoot>HDD:\</RemoteRoot>
    <ImageXexOutput>$(OutDir)hidmouse.xex</ImageXexOutput>
    <OutputFile>$(OutDir)hidmouse$(TargetExt)</OutputFile>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Xbox 360'">
    <ClCompile>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
      <Optimization>Full</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <PreprocessorDefinitions>NDEBUG;_XBOX;LTCG</PreprocessorDefinitions>
      <StringPooling>true</StringPooling>
      <ExceptionHandling>false</ExceptionHandling>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <BufferSecurityCheck>false</BufferSecurityCheck>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WholeProgramOptimization>true</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <SetChecksum>true</SetChecksum>
      <AdditionalOptions>/dll %(AdditionalOptions)</AdditionalOptions>
      <ProgramDatabaseFile>$(ProjectDir)$(Configuration)hidmouse.pdb</ProgramDatabaseFile>
      <EntryPointSymbol>
      </EntryPointSymbol>
    </Link>
    <ImageXex>
      <ConfigurationFile>xex.xml</ConfigurationFile>
    </ImageXex>
    <PostBuildEvent>
      <Command>
      </Command>
    </PostBuildEvent>
    <Deploy>
      <DeploymentType>CopyToHardDrive</DeploymentType>
    </Deploy>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Detours.h" />
    <ClInclude Include="HidMouseShared.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
  </ItemGroup>
  <ItemGroup>
    <None Include="xex.xml" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="DeployToHardDrive" Condition="'$(Platform)' == 'Xbox 360'">
    <!-- VS IDE (DeployOnBuild != false): deploy to console as usual -->
    <DeployToHardDrive Condition="'$(DeployOnBuild)' != 'false' and '%(Deploy.DeploymentType)' == 'CopyToHardDrive' and '%(Deploy.ExcludedFromBuild)' != 'true' and '$(ConfigurationType)' != 'StaticLibrary'" SuppressStartupBanner="%(Deploy.SuppressStartupBanner)" TargetConsole="%(Deploy.TargetConsole)" Progress="%(Deploy.Progress)" ForceCopy="%(Deploy.ForceCopy)" DeploymentFiles="%(Deploy.DeploymentFiles)" DeploymentRoot="%(Deploy.RemoteRoot)" XDKInstallDir="$(XDKInstallDir)" ProjectDir="$(ProjectDir)" DefaultConsole="$(DefaultConsole)" />
    <!-- Command line (DeployOnBuild=false): copy xex locally -->
    <Message Condition="'$(DeployOnBuild)' == 'false'" Text="DeployOnBuild=false: copiando xex a Distro360..." Importance="high" />
    <MakeDir Condition="'$(DeployOnBuild)' == 'false' and !Exists('$(ProjectDir)..\..\Distro360\plugins')" Directories="$(ProjectDir)..\..\Distro360\plugins" />
    <Copy Condition="'$(DeployOnBuild)' == 'false'" SourceFiles="$(ImageXexOutput)" DestinationFolder="$(ProjectDir)..\..\Distro360\plugins" />
  </Target>
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>