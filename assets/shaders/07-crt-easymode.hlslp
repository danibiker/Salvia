# CRT-Easymode. Precision completa por el mismo motivo que Lottes.
# Generado por utils/extract_shaders.py desde SDL_shaders_src.h.
# Formato de preset estilo RetroArch. El cuerpo es HLSL ps_3_0,
# no GLSL: por eso la extension es .hlslp/.hlsl y no .slangp/.slang.

shaders = "1"
shader0 = "07-crt-easymode.hlsl"
filter_linear0 = "false"
wrap_mode0 = "clamp_to_edge"
salvia_precision0 = "full"

salvia_label = "CRT Easymode"
salvia_label_key = "menu.video.shader7"
