    </ClCompile>
    <ClCompile Include="deps\lzma-19.00\src\LzFind.c">
      <AdditionalIncludeDirectories>$(ChdInc);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(ChdDef);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Include="deps\lzma-19.00\src\Lzma86Dec.c">
      <AdditionalIncludeDirectories>$(ChdInc);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(ChdDef);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Include="deps\lzma-19.00\src\LzmaDec.c">
      <AdditionalIncludeDirectories>$(ChdInc);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
