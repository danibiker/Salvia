# Nearest Neighbor: sin shader, solo estado de sampler (POINT).
# Generado por utils/extract_shaders.py desde SDL_shaders_src.h.
# Formato de preset estilo RetroArch. El cuerpo es HLSL ps_3_0,
# no GLSL: por eso la extension es .hlslp/.hlsl y no .slangp/.slang.

shaders = "1"
# Sin shader0: usa el passthrough integrado.
# shader0 = "passthrough.hlsl"   # equivalente, compilando un objeto propio
filter_linear0 = "false"
wrap_mode0 = "clamp_to_edge"
salvia_precision0 = "half"

salvia_label = "Nearest"
salvia_label_key = "menu.video.shader0"
